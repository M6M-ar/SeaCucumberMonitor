<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"> <com.serenegiant.widget.AspectRatioSurfaceView
    android:id="@+id/svAiCameraView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBoundingBoxOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@id/svAiCameraView"
        app:layout_constraintEnd_toEndOf="@id/svAiCameraView"
        app:layout_constraintStart_toStartOf="@id/svAiCameraView"
        app:layout_constraintTop_toTopOf="@id/svAiCameraView" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnAiBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:src="@drawable/ic_return"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="海底海参实时监测"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="#3300FF00"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="FPS: --"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3300FF00"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Conf: 0.70"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSeaCucumberCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#1A73E8"
                    android:textSize="64sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前海参数量"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiSnapshot"
                    android:layout_width="140dp"
                    android:layout_height="52dp"
                    android:text="拍照存档"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1A73E8"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_photo"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiSettings"
                    android:layout_width="140dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="参数设置"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#3C4043"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_setting"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>